{
  "name": "rikmukh-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "ALLOW_PLACEHOLDER_CONTENT=1 astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run test && npm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "astro": "7.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@types/culori": "4.0.1",
    "culori": "4.0.2",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
